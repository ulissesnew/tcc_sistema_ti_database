# Copy this file to .env before starting Docker Compose.
# Change the passwords before the first initialization.
MYSQL_DATABASE=sistema_ti
MYSQL_USER=sistema_ti
MYSQL_PASSWORD=change_this_application_password
MYSQL_ROOT_PASSWORD=change_this_root_password
# Use another unused local port if 3306 is already occupied.
MYSQL_PORT=3306
# Local web interface for inspecting the database.
ADMINER_PORT=8080
